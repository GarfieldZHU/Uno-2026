{
  "name": "uno-2026",
  "version": "0.1.0",
  "private": true,
  "description": "A Rust + WebAssembly UNO table with a React TypeScript offline client.",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "node scripts/build-wasm.mjs && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "cargo test -p uno-core",
    "test:rust": "cargo test -p uno-core",
    "test:browser": "playwright test",
    "check": "pnpm run typecheck && pnpm run build",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.11",
    "typescript": "^5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2"
  }
}
